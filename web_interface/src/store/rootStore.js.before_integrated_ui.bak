import { create } from 'zustand';

const empty = {
  market: {},
  marketCondition: {},
  broker: {},
  optionProgram: {},
  risk: {},
  strategies: {},
  positions: {},
  orders: [],
  executions: [],
  pnl: {},
  payoff: [],
  replay: {},
};

export const useStore = create((set) => ({
  ...empty,
  data: {},
  regime: 'NEUTRAL',
  coords: [],
  payoffCoords: [],

  updateData: (payload) => set((state) => {
    if (!payload || typeof payload !== 'object') return state;

    const next = {
      market: { ...state.market, ...(payload.market || {}) },
      marketCondition: { ...state.marketCondition, ...(payload.marketCondition || {}) },
      broker: { ...state.broker, ...(payload.broker || {}) },
      optionProgram: { ...state.optionProgram, ...(payload.optionProgram || {}) },
      risk: { ...state.risk, ...(payload.risk || {}) },
      strategies: { ...state.strategies, ...(payload.strategies || {}) },
      positions: { ...state.positions, ...(payload.positions || {}) },
      orders: Array.isArray(payload.orders) ? payload.orders : state.orders,
      executions: Array.isArray(payload.executions) ? payload.executions : state.executions,
      pnl: { ...state.pnl, ...(payload.pnl || {}) },
      payoff: Array.isArray(payload.payoff) ? payload.payoff : state.payoff,
      replay: { ...state.replay, ...(payload.replay || {}) },
    };

    const point = payload.market
      ? { x: payload.market.seq_id || 0, y: Number(payload.market.price || 0) }
      : null;

    const coords = point
      ? [...state.coords, point].slice(-100)
      : state.coords;

    return {
      ...next,
      data: { ...state.data, ...payload },
      regime: next.marketCondition.regime || state.regime,
      coords,
      payoffCoords: next.payoff,
    };
  }),
}));

