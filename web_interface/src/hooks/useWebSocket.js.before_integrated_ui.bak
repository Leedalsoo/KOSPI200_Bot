import { useEffect, useState, useCallback, useRef } from 'react';
import { useStore } from '../store/rootStore';

export const useWebSocket = (url) => {
  const [isConnected, setIsConnected] = useState(false);
  const [lastData, setLastData] = useState(null);
  const updateData = useStore((state) => state.updateData);
  const reconnectCount = useRef(0);
  const reconnectTimerRef = useRef(null);
  const throttleTimerRef = useRef(null);
  const pendingDataRef = useRef(null);
  const wsRef = useRef(null);

  const flush = useCallback(() => {
    if (pendingDataRef.current) {
      const payload = pendingDataRef.current;
      pendingDataRef.current = null;
      updateData(payload);
      setLastData(payload);
    }
    throttleTimerRef.current = null;
  }, [updateData]);

  const sendCommand = useCallback((command) => {
    if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {
      wsRef.current.send(JSON.stringify(command));
      return true;
    }
    return false;
  }, []);

  const connect = useCallback(() => {
    if (reconnectTimerRef.current) clearTimeout(reconnectTimerRef.current);

    const ws = new WebSocket(url);
    wsRef.current = ws;

    ws.onopen = () => {
      setIsConnected(true);
      reconnectCount.current = 0;
    };

    ws.onmessage = (event) => {
      try {
        if (!event.data) return;
        const parsed = JSON.parse(event.data);
        if (!parsed || typeof parsed !== 'object') return;

        pendingDataRef.current = Object.freeze({ ...parsed });

        if (!throttleTimerRef.current) {
          throttleTimerRef.current = setTimeout(flush, 200);
        }
      } catch (error) {
        console.error('Packet Parsing Error:', error);
      }
    };

    ws.onclose = () => {
      setIsConnected(false);
      if (wsRef.current === ws) wsRef.current = null;
      const delay = Math.min(1000 * (2 ** reconnectCount.current), 30000);
      reconnectCount.current += 1;
      reconnectTimerRef.current = setTimeout(connect, delay);
    };

    ws.onerror = () => {
      try { ws.close(); } catch (_) {}
    };

    return ws;
  }, [url, flush]);

  useEffect(() => {
    const ws = connect();
    return () => {
      if (reconnectTimerRef.current) clearTimeout(reconnectTimerRef.current);
      if (throttleTimerRef.current) clearTimeout(throttleTimerRef.current);
      pendingDataRef.current = null;

      if (wsRef.current) {
        wsRef.current.onclose = null;
        try { wsRef.current.close(); } catch (_) {}
      } else if (ws) {
        ws.onclose = null;
        try { ws.close(); } catch (_) {}
      }
    };
  }, [connect]);

  return { isConnected, lastData, sendCommand };
};

